.main-menu-root {
	background_color: #0d0f16;
	padding: 16;
}
.run-root {
	background_color: #0d0f16;
	padding: 16;
}
.panel {
	background_color: #151927;
	border_color: #2a3150;
	border_width: 1;
	border_radius: 6;
	padding: 12;
}
.section-title { font_size: 20; font_color: #c9cfe8; }
.stat-name { font_size: 16; font_color: #e8ecff; }
.stat-value { font_size: 16; font_color: #8f96b8; }

.pause-menu-panel {
	background_color: #091219;
	border_color: #3a4260;
	border_width: 2;
	border_radius: 10;
	padding: 16;
}

.pause-menu-description-panel {
	background_color: #2a3150;
	border_color: #2a3150;
	border_width: 1;
	border_radius: 6;
	padding: 12;
}

// ---------- buttons ---------
.btn {
	background_color: #2b3040;
	border_color: #4a5270;
	border_width: 2;
	border_radius: 6;
	padding: 8 12;
	font_color: #e8ecff;
	font_size: 16;
	transition_duration: 120ms;
	transition_easing: ease_out;
}
.btn:hover { background_color: #3a4260; }
.btn:pressed { background_color: #1f2433; }
.btn:disabled { background_color: #20232d; border_color: #2e3345; font_color: #6b7088; }

.btn.modal { padding: 8 4; font_size: 20; }
.btn.confirm { border_color: #01EF02; }
.btn.cancel { border_color: #EF0102; }

.btn.close { background_color: #BC0102; border_width: 0; }
.btn.close:hover { background_color: #EF0102; }

.btn.selected { border_color: #7a8cff; background_color: #2f3a66; }
.btn.active { border_color: #7aff9c; }
.btn.hand-card { border_color: #ffd27a; }
.btn.primary { font_size: 22; padding: 14 28; }
.btn.pause-menu { padding: 8 10; }

.btn.text-color-red:hover {
	font_color: #DE0000;
}

.settings-hint { font_size: 16; font_color: #8f96b8; }
.settings-label { font_size: 20; font_color: #c9cfe8; }
.settings-input {
	background_color: #1b1f2b;
	border_color: #4a5270;
	border_width: 1;
	border_radius: 4;
	padding: 8;
	input_font_color: #e8ecff;
	input_font_size: 20;
	transition_duration: 120ms;
}
.settings-input:focus { border_color: #7a8cff; }

// ---------- checkbox / radio ----------
.checkbox {
	padding: 4;
	box_background_color: #1b1f2b;
	box_border_color: #4a5270;
	box_border_width: 2;
	box_border_radius: 4;
	mark_background_color: #7a8cff;
	mark_border_radius: 2;
	label_font_color: #e8ecff;
	label_font_size: 20;
	transition_duration: 120ms;
}
.checkbox:hover { box_border_color: #7a8cff; }
.checkbox:focus { background_color: #ffffff10; }
.checkbox:disabled { label_font_color: #6b7088; box_border_color: #2e3345; }

.radio {
	padding: 4;
	box_background_color: #1b1f2b;
	box_border_color: #4a5270;
	box_border_width: 2;
	box_border_radius: 10;
	mark_background_color: #7a8cff;
	mark_border_radius: 10;
	label_font_color: #e8ecff;
	label_font_size: 20;
}
.radio:hover { box_border_color: #7a8cff; }

// ---------- dropdown ----------
.settings-input { font_color: #e8ecff; font_size: 20; caret_font_color: #8f96b8; }
.settings-input:open { border_color: #7a8cff; }
.dropdown-list {
	background_color: #1b1f2b;
	border_color: #4a5270;
	border_width: 1;
	border_radius: 4;
	padding: 4;
}
.dropdown-option { background_color: #1b1f2b; font_color: #e8ecff; padding: 8; }
.dropdown-option:hover { background_color: #2b3040; }
.dropdown-option.selected { background_color: #3a4260; }

// ---------- slider ----------
.slider {
	track_background_color: #2b3040;
	track_border_radius: 4;
	fill_background_color: #7a8cff;
	fill_border_radius: 4;
	thumb_background_color: #e8ecff;
	thumb_border_radius: 11;
	thumb_border_color: #7a8cff;
	thumb_border_width: 2;
	value_font_color: #c9cfe8;
	label_font_color: #c9cfe8;
	transition_duration: 120ms;
}
.slider:hover { thumb_background_color: #ffffff; }
.slider:pressed { fill_background_color: #9aa8ff; }
.slider:disabled { fill_background_color: #4a5270; thumb_background_color: #8f96b8; }
