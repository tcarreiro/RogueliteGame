[sub_resource type="Shader" id="Shader_84jm5"]
resource_local_to_scene = true
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;
uniform bool play = false;
uniform vec4 water_color : source_color;
uniform sampler2D wave_noise : repeat_enable;
uniform float water_transparency: hint_range(0.0, 1.0) = 0.2;
uniform float water_strength: hint_range(0.0, 0.05) = 0.025;
uniform float water_speed: hint_range(0.0, 0.05) = 0.025;

void fragment() {
	//float sin_val = sin(PI*TIME);
	float sin_val = TIME;
	vec2 water_wave = (texture(wave_noise, UV + water_speed * sin_val).xy - 0.5) * water_strength;
	if (!play) {
		water_wave = (texture(wave_noise, UV + water_speed).xy - 0.5) * water_strength;
	}

	vec4 bg = texture(TEXTURE, UV + water_wave);
    // mistura água x fundo de acordo com transparência
    vec4 water_mix = mix(water_color, bg, water_transparency);

    // aplica à textura da água
    COLOR = texture(TEXTURE, UV + water_wave);
	COLOR *= texture(TEXTURE, UV + water_wave) * water_mix;
	
	
}
"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_qwgq2"]
noise_type = 3
frequency = 0.0216

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_sx4qv"]
