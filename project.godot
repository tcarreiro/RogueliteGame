; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RogueliteGame"
run/main_scene="uid://jnltcvrkb78v"
config/features=PackedStringArray("4.8", "Forward Plus")

[autoload]

GameManager="*uid://b70w5l6gytx1m"
SaveManager="*uid://bm3pq26t61fye"
FactorRegistry="*uid://44emqs5n2hpy"
EventRegistry="*uid://dmvxbgsci0dd7"
AddonRegistry="*uid://b8n37th7ya3ib"
DatashardRegistry="*uid://c5cryitvv21i7"
EquipmentRegistry="*uid://kissld841vf7"
CardRegistry="*uid://b763l6ax1847l"
SceneMap="*uid://bfxewhtnqx4by"
LuaBridgeRegistry="*res://addons/lua-modder/LuaBridgeRegistry.gd"
GameLogger="*uid://cubsfekvkib58"
ComponentRegistry="*res://addons/lua-modder/UI/Registries/component_registry.gd"
LuaUi="*res://addons/lua-modder/UI/LuaUi.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RogueliteGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/lua-gdextension/plugin.cfg", "res://addons/lua-modder/plugin.cfg")

[file_customization]

folder_colors={
"res://Backend/DTOs/": "pink",
"res://Backend/Definitions/": "yellow",
"res://Backend/Managers/": "green",
"res://Backend/ModdableContent/": "blue",
"res://Backend/Registries/": "red",
"res://Backend/States/": "purple"
}

[gdss]

internal/initialized=true
editor/use_minimap=true
editor/show_outline=true

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
