[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[internationalization]

locale/translations=PackedStringArray("res://Frontend/Localization/translations.en.translation", "res://Frontend/Localization/translations.pt_BR.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
